# ── Application ──────────────────────────────────────────────────
# APP_ENV=production enables fail-fast security validation on startup
# (rejects the default SECRET_KEY and CORS "*"). Use "development" for local runs.
APP_ENV=production

# ── Database ──────────────────────────────────────────────────────
# SQLite (default, no extra setup needed):
DATABASE_URL=sqlite:////data/invest_ai.db

# PostgreSQL (recommended for production). Driver (psycopg2) ships in
# requirements.txt, so this works out of the box — just point at a running
# Postgres. With docker-compose, uncomment the `db` service and use host "db":
# DATABASE_URL=postgresql+psycopg2://invest:invest@db:5432/invest_ai
# Standalone (Postgres on localhost):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/invest_ai

# ── AI ────────────────────────────────────────────────────────────
# Sending project data to external AI providers is OFF by default in production.
# Enable it explicitly in Settings (CFO) after confirming the data-egress policy.
# Prefer environment variables over storing keys in the settings file.
# OpenAI (default provider):
OPENAI_API_KEY=sk-...

# Anthropic Claude (alternative provider, set ai_provider=anthropic in Settings):
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Hermes (AI-помощник) ─────────────────────────────────────────
# Обезличивание данных перед отправкой в ИИ включено по умолчанию
# (управляется флагом anonymize_enabled в настройках). Оповещения об
# ошибках отправляются в служебный канал Mattermost через incoming webhook.
# MATTERMOST_ALERT_WEBHOOK=https://mattermost.example.com/hooks/xxxxxxxxxxxx
# Уровень структурного (JSON) логирования: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────
# REQUIRED in production: a random string of at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Encrypts AI API keys stored in the settings file (/data/settings.json) at rest.
# Any passphrase works (stretched to a Fernet key via SHA-256). Without it, keys
# stored via the Settings UI are kept in plaintext on disk.
SETTINGS_ENCRYPTION_KEY=change-me-to-a-long-random-passphrase

# JWT session lifetime in minutes (shorter = smaller blast radius if a token leaks).
JWT_EXPIRE_MINUTES=120

# Seed CEO/CFO passwords (created on first startup with an empty DB).
# Leave unset to auto-generate a strong random password and recover the account
# via "Забыли пароль?". Never commit real values.
# SEED_CEO_PASSWORD=
# SEED_CFO_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────────
# In production this MUST be an explicit list of origins ("*" is rejected at
# startup because credentials are enabled).
CORS_ORIGINS=["https://your-domain.com"]

# ── SMTP (email sending for registration) ─────────────────────────
# Required for self-registration: a one-time link to set the password is emailed
# to the new user (the password itself is never sent).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@your-domain.com

# ── SSO / OIDC (optional) ─────────────────────────────────────────
# Single sign-on via any OpenID Connect provider (Keycloak, Okta, Azure AD,
# Google, …). SSO is OFF unless OIDC_ISSUER_URL is set. When enabled, a
# "Войти через SSO" button appears on the login page and new users are
# provisioned with SSO_DEFAULT_ROLE on first login. The id_token is verified
# (signature via the provider's JWKS, issuer, audience, nonce).
# OIDC_ISSUER_URL=https://keycloak.example.com/realms/myrealm
# OIDC_CLIENT_ID=invest-ai
# OIDC_CLIENT_SECRET=change-me
# Must exactly match the redirect URI registered with the provider:
# OIDC_REDIRECT_URI=https://your-domain.com/api/v1/auth/sso/callback
# Role for accounts auto-created via SSO (ceo | cfo | manager | owner):
# SSO_DEFAULT_ROLE=owner
